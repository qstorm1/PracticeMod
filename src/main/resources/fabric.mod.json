{
	"schemaVersion": 1,
	"id": "practice-mod",
	"version": "${version}",
	"name": "practice mod",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/practice-mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.qstorm.PracticeMod"
		],
		"client": [
			"com.qstorm.PracticeModClient"
		],
		"fabric-datagen": [
			"com.qstorm.PracticeModDataGenerator"
		],
		"cardinal-components-entity": [
			"com.qstorm.cca.EntityComponentInitializer"
		]
	},
	"mixins": [
		"practice-mod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"player_animation_library": "*",
		"cardinal-components-base": "*",
		"cardinal-components-entity": "*",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"custom": {
		"cardinal-components": [
			"practice-mod:player-data",
			"practice-mod:sorcery-info-data",
			"practice-mod:player-combo-list",
			"practice-mod:entity-force",
			"practice-mod:old-pos-after-domain"
		]
	}
}